@startuml
title SignIA - Flujo de comunicación End-to-End (E2E)

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial

skinparam rectangle {
    BorderColor #1F4E79
    FontColor #1F2937
    BackgroundColor #F8FAFC
}

skinparam component {
    BorderColor #1F4E79
    FontColor #1F2937
    BackgroundColor #EAF2F8
}

skinparam database {
    BorderColor #1F4E79
    FontColor #1F2937
    BackgroundColor #F3F6F9
}

actor "Usuario" as usuario

rectangle "CAPA DE PRESENTACIÓN\nReact + Vite" as frontend {
    component "App.jsx" as app
    component "api.js" as api
}

rectangle "CAPA DE COMUNICACIÓN\nHTTP / CORS" as comunicacion {
    component "fetch()" as fetch
    component "Middleware CORS" as cors
}

rectangle "CAPA DE BACKEND\nFastAPI" as backend {
    component "POST /api/v1/predict" as predict
}

rectangle "CAPA DE PROCESAMIENTO\nVisión por computadora" as procesamiento {
    component "vision_service.py" as vision
    component "MediaPipe" as mediapipe
}

rectangle "RESPUESTA" as respuesta {
    component "JSON" as json
}

usuario --> app : 1. Selecciona imagen
app --> api : 2. Solicita procesamiento
api --> fetch : 3. Prepara petición
fetch --> cors : 4. HTTP POST
cors --> predict : 5. Solicitud autorizada
predict --> vision : 6. Envía imagen
vision --> mediapipe : 7. Procesa imagen
mediapipe --> vision : 8. Obtiene landmarks
vision --> json : 9. Genera resultado
json --> predict : 10. Retorna respuesta
predict --> api : 11. Respuesta JSON
api --> app : 12. Entrega resultado
app --> usuario : 13. Muestra resultado visual

note right of mediapipe
Detección de mano
y extracción de
21 landmarks
end note

note right of json
Respuesta actual:
status: ok
vision: landmarks
prediction: null
end note

@enduml